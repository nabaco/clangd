+bool indexProject(llvm::StringRef ProjectPath, const ThreadsafeFS &TFS,
+                  const GlobalCompilationDatabase &CDB, unsigned ThreadPoolSize,
+                  llvm::ThreadPriority IndexingPriority) {
+  trace::Span Tracer("IndexProject");
+  log("Indexing project at {0}", ProjectPath);
+  
+  // Get the compilation database for the project
+  // We need to load compile_commands.json to get all files
+  std::string DatabaseLoadErrorMessage;
+  std::unique_ptr<tooling::CompilationDatabase> CompileDB =
+      tooling::CompilationDatabase::autoDetectFromDirectory(
+          ProjectPath, DatabaseLoadErrorMessage);
+  
+  if (!CompileDB) {
+    elog("Failed to load compilation database from {0}: {1}",
+         ProjectPath, DatabaseLoadErrorMessage);
+    return false;
+  }
+  
+  // Get all files from the compilation database
+  auto AllFiles = CompileDB->getAllFiles();
+  if (AllFiles.empty()) {
+    elog("No files found in compilation database");
+    return false;
+  }
+  
+  log("Found {0} files to index", AllFiles.size());
+  
+  // Create a BackgroundIndex to index all files
+  BackgroundIndex::Options BGOpts;
+  BGOpts.ThreadPoolSize = std::max(ThreadPoolSize, 1u);
+  BGOpts.IndexingPriority = IndexingPriority;
+  
+  // Progress callback to show indexing progress
+  BGOpts.OnProgress = [](BackgroundQueue::Stats S) {
+    if (S.Completed % 10 == 0 || S.Completed == S.Enqueued) {
+      log("Indexed {0}/{1} files", S.Completed, S.Enqueued);
+    }
+  };
+  
+  // Create storage factory for disk-backed index shards
+  auto IndexStorageFactory = BackgroundIndexStorage::createDiskBackedStorageFactory(
+      [&CDB](PathRef File) { return CDB.getProjectInfo(File); });
+  
+  // Create the background index
+  auto BgIndex = std::make_unique<BackgroundIndex>(
+      TFS, CDB, std::move(IndexStorageFactory), std::move(BGOpts));
+  
+  // Enqueue all files for indexing
+  BgIndex->enqueue(AllFiles);
+  
+  // Wait for indexing to complete
+  log("Waiting for indexing to complete...");
+  if (!BgIndex->blockUntilIdleForTest(/*TimeoutSeconds=*/std::nullopt)) {
+    elog("Indexing did not complete");
+    return false;
+  }
+  
+  log("Indexing completed successfully");
+  return true;
+}
